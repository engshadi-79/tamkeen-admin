{
  "manifest_version": 3,
  "name": "وكيل تمكين لنظام المركز",
  "version": "1.5.6",
  "description": "ينفّذ أوامر تمكين داخل جلستك في نظام المركز، بمعاينة وموافقة قبل أي كتابة.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://tamkeen.ksach.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "وكيل تمكين"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tamkeen-admin.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tamkeen.ksach.org/*"
      ],
      "js": [
        "agent.js",
        "agent-boot.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
